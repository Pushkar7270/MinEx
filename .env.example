# Copy to .env and fill in. .env is gitignored — secrets never enter the repo.
# JWT signing secret (min 32 chars) for local dev:
APP_JWT_SECRET=change-me-to-a-256-bit-secret-for-local-dev-only-0123456789
# LLM segregation (PRD 4.3 fallback): none | ollama | openai-compatible
APP_LLM_PROVIDER=none
APP_LLM_ENDPOINT=http://localhost:11434
APP_LLM_MODEL=llama3.1:8b
# Hosted models only (e.g. Moonshot Kimi). Leave empty otherwise:
APP_LLM_API_KEY=
# Dashboard build:
VITE_API_URL=http://localhost:8080
