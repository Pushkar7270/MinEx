# Local dev — copy to .env, never commit real secrets.
APP_JWT_SECRET=change-me-to-a-256-bit-secret-for-local-dev-only-0123456789
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/intellireport
SPRING_DATASOURCE_USERNAME=intellireport
SPRING_DATASOURCE_PASSWORD=intellireport
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=intellireport-docs
# LLM segregation (PRD 4.3 fallback): none | ollama | openai-compatible
APP_LLM_PROVIDER=none
APP_LLM_ENDPOINT=http://localhost:11434
APP_LLM_MODEL=llama3.1:8b
# APP_LLM_API_KEY=...  # only for openai-compatible (e.g. hosted Kimi)
